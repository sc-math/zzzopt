# Exemplo sem segredos. Copie para .env e preencha localmente.
# O servidor PostgreSQL rodará em Docker Compose; não requer instalação local.
# O Compose usa estas variáveis sem exigir instalação local de PostgreSQL/Flyway.
POSTGRES_DB=zzzopt
POSTGRES_USER=zzzopt
POSTGRES_PASSWORD=substitua_por_uma_senha_local
POSTGRES_PORT=5432
